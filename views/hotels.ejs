<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="/bootstrap/css/bootstrap.min.css"
  >
</head>

<body>
  <%- include("partials/authStatus") %>

  <% const isAdmin =
    currentUser && currentUser.Role === 'Admin'; %>

  <main class="container py-4">
    <h1 class="h2 mb-4">Choose a hotel</h1>

    <div
      id="hotel-message"
      role="alert"
      hidden
    ></div>

    <% if (hotels.length === 0) { %>
      <div class="alert alert-info">
        No hotels are currently available.
      </div>
    <% } else { %>
      <div class="list-group">
        <% hotels.forEach(function (hotel) { %>
          <div
            class="list-group-item
                   d-flex
                   justify-content-between
                   align-items-center
                   gap-3"
          >
            <div>
              <strong><%= hotel.Name %></strong>

              <span class="text-body-secondary ms-2">
                <%= hotel.Location %>
              </span>
            </div>

            <div class="d-flex gap-2">
              <a
                href="/rooms/<%= hotel.id %>"
                class="btn btn-secondary btn-sm"
              >
                <%= currentUser ? 'Rent a room' : 'View rooms' %>
              </a>

              <a
                href="/hotels/<%= hotel.id %>"
                class="btn btn-outline-secondary btn-sm"
              >
                Details
              </a>

              <% if (isAdmin) { %>
                <button
                  type="button"
                  class="btn btn-outline-danger btn-sm delete-hotel"
                  data-hotel-id="<%= hotel.id %>"
                  data-hotel-name="<%= hotel.Name %>"
                >
                  Delete
                </button>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (isAdmin) { %>
      <section class="card mt-4">
        <div class="card-body">
          <h2 class="h5 card-title">Add a hotel</h2>

          <form id="add-hotel-form" class="row g-3">
            <div class="col-md-5">
              <label for="hotel-name" class="form-label">
                Hotel name
              </label>

              <input
                type="text"
                id="hotel-name"
                name="Name"
                class="form-control"
                maxlength="255"
                required
              >
            </div>

            <div class="col-md-5">
              <label for="hotel-location" class="form-label">
                Location
              </label>

              <input
                type="text"
                id="hotel-location"
                name="Location"
                class="form-control"
                maxlength="255"
                required
              >
            </div>

            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-success w-100">
                Add hotel
              </button>
            </div>
          </form>
        </div>
      </section>
    <% } %>
  </main>

  <% if (isAdmin) { %>
    <script src="/javascripts/hotels.js"></script>
  <% } %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="/bootstrap/css/bootstrap.min.css"
  >
</head>

<body>
  <main class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h2 mb-0">Choose a room</h1>

      <a href="/hotels" class="btn btn-outline-secondary">
        Back to hotels
      </a>
    </div>

    <% if (reservationCreated) { %>
      <div class="alert alert-success">
        Your reservation was created.
      </div>
    <% } %>

    <% if (rooms.length === 0) { %>
      <div class="alert alert-info">
        This hotel currently has no available rooms.
      </div>
    <% } else { %>
      <div class="list-group">
        <% rooms.forEach(function (room) { %>
          <div class="list-group-item">
            <div class="mb-3">
              <strong>
                Room for <%= room.Capacity %> people
              </strong>

              <span class="text-body-secondary ms-2">
                <%= Number(room.PricePerDay).toFixed(2) %> per day
              </span>
            </div>

            <form
              method="POST"
              action="/rooms/<%= room.id %>/reservations"
              class="row g-3 align-items-end"
            >
              <input
                type="hidden"
                name="hotelId"
                value="<%= hotelId %>"
              >

              <div class="col-md-4">
                <label
                  for="startDate-<%= room.id %>"
                  class="form-label"
                >
                  Arrival
                </label>

                <input
                  type="datetime-local"
                  id="startDate-<%= room.id %>"
                  name="startDate"
                  class="form-control"
                  required
                >
              </div>

              <div class="col-md-4">
                <label
                  for="endDate-<%= room.id %>"
                  class="form-label"
                >
                  Departure
                </label>

                <input
                  type="datetime-local"
                  id="endDate-<%= room.id %>"
                  name="endDate"
                  class="form-control"
                  required
                >
              </div>

              <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                  Rent this room
                </button>
              </div>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>